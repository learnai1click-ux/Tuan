[
 {
  "id": "v01",
  "at": 0.8,
  "text": "Sáng luôn tự hứa: ngày mai, mình sẽ học ây ai.",
  "file": "v01.wav",
  "duration": 2.763
 },
 {
  "id": "v01b",
  "at": 4.5,
  "text": "Còn tối nay, lướt thêm một chút đã.",
  "file": "v01b.wav",
  "duration": 1.927
 },
 {
  "id": "v02",
  "at": 8.4,
  "text": "Nhưng ngày mai nào, cũng có một lý do khác.",
  "file": "v02.wav",
  "duration": 2.101
 },
 {
  "id": "v03",
  "at": 16.3,
  "text": "Điều cản đường, chưa bao giờ là thời gian. Mà là chưa từng bắt đầu.",
  "file": "v03.wav",
  "duration": 3.32
 },
 {
  "id": "v04",
  "at": 22.2,
  "text": "Tối nay, Sáng tắt điện thoại.",
  "file": "v04.wav",
  "duration": 1.347
 },
 {
  "id": "v05",
  "at": 26.5,
  "text": "Một giờ mỗi ngày.",
  "file": "v05.wav",
  "duration": 0.859
 },
 {
  "id": "v06",
  "at": 31.2,
  "text": "Một bài học. Một dự án nhỏ.",
  "file": "v06.wav",
  "duration": 1.385
 },
 {
  "id": "v07",
  "at": 36.2,
  "text": "Lời thì thầm vẫn còn đó, nhưng nhỏ dần.",
  "file": "v07.wav",
  "duration": 2.264
 },
 {
  "id": "v08",
  "at": 41.2,
  "text": "Từng ngày một, từng chút một.",
  "file": "v08.wav",
  "duration": 1.161
 },
 {
  "id": "v09",
  "at": 46.3,
  "text": "Và rồi, Sáng nhận ra.",
  "file": "v09.wav",
  "duration": 1.335
 },
 {
  "id": "v10",
  "at": 52.3,
  "text": "Không cần hoàn hảo. Chỉ cần bắt đầu.",
  "file": "v10.wav",
  "duration": 1.776
 },
 {
  "id": "v11",
  "at": 56.2,
  "text": "Hãy bắt đầu, ngay hôm nay.",
