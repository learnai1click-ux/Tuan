[
 {"id": "e01", "at": 0.6,  "text": "Every morning, you make the same promise."},
 {"id": "e02", "at": 3.9,  "text": "Tomorrow. I'll start tomorrow."},
 {"id": "e03", "at": 7.3,  "text": "And every night, something louder wins."},
 {"id": "e04", "at": 11.1, "text": "A year goes by. And nothing changes."},
 {"id": "e05", "at": 15.3, "text": "Here's the truth nobody tells you."},
 {"id": "e06", "at": 18.2, "text": "Motivation won't save you."},
 {"id": "e07", "at": 20.5, "text": "Decisions will."},
 {"id": "e08", "at": 22.3, "text": "So today..."},
 {"id": "e09", "at": 24.4, "text": "you get up."},
 {"id": "e10", "at": 27.4, "text": "Not because it's easy."},
 {"id": "e11", "at": 29.5, "text": "Because you're done waiting."},
 {"id": "e12", "at": 32.6, "text": "One rep. One page. One mile."},
 {"id": "e13", "at": 36.6, "text": "When it hurts, you keep going."},
 {"id": "e14", "at": 39.8, "text": "When nobody's watching,"},
 {"id": "e15", "at": 42.0, "text": "you keep going."},
 {"id": "e16", "at": 47.2, "text": "And one day, the voice that held you back,"},
 {"id": "e17", "at": 50.2, "text": "can't even reach you."},
 {"id": "e18", "at": 53.3, "text": "You don't need a new year. You need a new day."},
 {"id": "e19", "at": 57.3, "text": "Start now."}
]
